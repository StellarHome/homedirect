# HomeDirect Environment Variables

# Stellar Network Configuration
STELLAR_NETWORK=testnet
STELLAR_SECRET_KEY=

# Paystack Configuration
PAYSTACK_SECRET_KEY=your_paystack_secret_key_here
PAYSTACK_PUBLIC_KEY=your_paystack_public_key_here

# Dojah KYC Configuration
DOJAH_API_KEY=your_dojah_api_key_here
DOJAH_APP_ID=your_dojah_app_id_here

# Platform Configuration
PLATFORM_EMAIL=admin@homedirect.ng
PLATFORM_WALLET_ADDRESS=

# Database Configuration
DATABASE_URL=postgresql://homedirect:homedirect_password@localhost:5432/homedirect
DB_HOST=localhost
DB_PORT=5432
DB_NAME=homedirect
DB_USER=homedirect
DB_PASSWORD=homedirect_password
DB_SSL=false

# Relayer Configuration
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_STELLAR_NETWORK=testnet
